// Создание заказа
public async Task<Order> CreateOrderAsync(Guid customerId, decimal totalAmount)
{
    // Проверяем наличие клиента
    var customer = await _customers.GetByIdAsync(customerId);
    if (customer == null)
        throw new InvalidOperationException("Клиент не найден.");

    // Создаём и сохраняем заказ
    var order = new Order { CustomerId = customerId, TotalAmount = totalAmount };
    await _orders.AddAsync(order);

    // Отправляем событие
    await _bus.PublishAsync("order.created", new { order.Id, order.CustomerId });
    return order;
}

// Подтверждение оплаты
public async Task ConfirmPaymentAsync(Guid orderId)
{
    var order = await GetOrderAsync(orderId); // Находим заказ
    order.Status = OrderStatus.Paid; // Меняем статус
    await _orders.UpdateAsync(order); // Сохраняем
    await _bus.PublishAsync("order.paid", new { order.Id }); // Отправляем событие
}

// Отмена заказа
public async Task CancelOrderAsync(Guid orderId)
{
    var order = await GetOrderAsync(orderId); // Находим заказ
    order.Status = OrderStatus.Cancelled; // Отменяем
    await _orders.UpdateAsync(order); // Сохраняем
    await _bus.PublishAsync("order.cancelled", new { order.Id }); // Отправляем событие
}

// Отгрузка заказа
public async Task ShipOrderAsync(Guid orderId)
{
    var order = await GetOrderAsync(orderId); // Находим заказ

    // Отгружать можно только оплаченный заказ
    if (order.Status != OrderStatus.Paid)
        throw new InvalidOperationException(
            "Отправить можно только оплаченные заказы.");

    order.Status = OrderStatus.Shipped; // Меняем статус
    await _orders.UpdateAsync(order); // Сохраняем
    await _bus.PublishAsync("order.shipped", new { order.Id }); // Отправляем событие
}

// Поиск заказа
private async Task<Order> GetOrderAsync(Guid orderId)
{
    return await _orders.GetByIdAsync(orderId)
        ?? throw new InvalidOperationException("Заказ не найден.");
}





using FluentAssertions;
using Moq;
using Xunit;
using OrderProcessing.Interfaces;
using OrderProcessing.Models;
using OrderProcessing.Services;

public class OrderServiceTests
{
    // Создаём подмены зависимостей
    private readonly Mock<IOrderRepository> _orders = new();
    private readonly Mock<ICustomerRepository> _customers = new();
    private readonly Mock<IMessageBus> _bus = new();
    private readonly OrderService _service;

    public OrderServiceTests()
    {
        // Передаём подмены сервису
        _service = new(_orders.Object, _customers.Object, _bus.Object);
    }

    // Создание заказа
    [Fact]
    public async Task CreateOrder()
    {
        var id = Guid.NewGuid();

        // Возвращаем клиента
        _customers.Setup(x => x.GetByIdAsync(id))
            .ReturnsAsync(new Customer { Id = id, Name = "Иван", Email = "ivan@example.com" });

        _orders.Setup(x => x.AddAsync(It.IsAny<Order>()))
            .Returns(Task.CompletedTask);
        _bus.Setup(x => x.PublishAsync("order.created", It.IsAny<object>()))
            .Returns(Task.CompletedTask);

        // Проверяем созданный заказ
        var result = await _service.CreateOrderAsync(id, 100m);
        result.CustomerId.Should().Be(id);
        result.TotalAmount.Should().Be(100m);

        // Проверяем сохранение
        _orders.Verify(x => x.AddAsync(It.IsAny<Order>()), Times.Once);
    }

    // Клиент не найден
    [Fact]
    public async Task CreateOrderWithoutCustomer()
    {
        var id = Guid.NewGuid();

        // Имитируем отсутствие клиента
        _customers.Setup(x => x.GetByIdAsync(id))
            .ReturnsAsync((Customer?)null);

        // Проверяем исключение
        var act = () => _service.CreateOrderAsync(id, 100m);
        await act.Should().ThrowAsync<InvalidOperationException>();
    }

    // Подтверждение оплаты
    [Fact]
    public async Task ConfirmPayment()
    {
        var order = new Order { Id = Guid.NewGuid(), Status = OrderStatus.Pending };

        // Настраиваем получение заказа
        _orders.Setup(x => x.GetByIdAsync(order.Id)).ReturnsAsync(order);
        _orders.Setup(x => x.UpdateAsync(order)).Returns(Task.CompletedTask);
        _bus.Setup(x => x.PublishAsync("order.paid", It.IsAny<object>()))
            .Returns(Task.CompletedTask);

        // Проверяем смену статуса
        await _service.ConfirmPaymentAsync(order.Id);
        order.Status.Should().Be(OrderStatus.Paid);
    }

    // Заказ для оплаты не найден
    [Fact]
    public async Task ConfirmPaymentWithoutOrder()
    {
        var id = Guid.NewGuid();

        // Возвращаем отсутствие заказа
        _orders.Setup(x => x.GetByIdAsync(id)).ReturnsAsync((Order?)null);

        // Проверяем исключение
        var act = () => _service.ConfirmPaymentAsync(id);
        await act.Should().ThrowAsync<InvalidOperationException>();
    }

    // Отмена заказа
    [Fact]
    public async Task CancelOrder()
    {
        var order = new Order { Id = Guid.NewGuid(), Status = OrderStatus.Pending };

        // Настраиваем подмены
        _orders.Setup(x => x.GetByIdAsync(order.Id)).ReturnsAsync(order);
        _orders.Setup(x => x.UpdateAsync(order)).Returns(Task.CompletedTask);
        _bus.Setup(x => x.PublishAsync("order.cancelled", It.IsAny<object>()))
            .Returns(Task.CompletedTask);

        // Проверяем отмену
        await _service.CancelOrderAsync(order.Id);
        order.Status.Should().Be(OrderStatus.Cancelled);
    }

    // Отменяемый заказ не найден
    [Fact]
    public async Task CancelOrderWithoutOrder()
    {
        var id = Guid.NewGuid();
        _orders.Setup(x => x.GetByIdAsync(id)).ReturnsAsync((Order?)null);

        // Проверяем исключение
        var act = () => _service.CancelOrderAsync(id);
        await act.Should().ThrowAsync<InvalidOperationException>();
    }

    // Отгрузка оплаченного заказа
    [Fact]
    public async Task ShipOrder()
    {
        var order = new Order { Id = Guid.NewGuid(), Status = OrderStatus.Paid };

        // Настраиваем подмены
        _orders.Setup(x => x.GetByIdAsync(order.Id)).ReturnsAsync(order);
        _orders.Setup(x => x.UpdateAsync(order)).Returns(Task.CompletedTask);
        _bus.Setup(x => x.PublishAsync("order.shipped", It.IsAny<object>()))
            .Returns(Task.CompletedTask);

        // Проверяем отгрузку
        await _service.ShipOrderAsync(order.Id);
        order.Status.Should().Be(OrderStatus.Shipped);
    }

    // Отгрузка заказа с неподходящим статусом
    [Theory]
    [InlineData(OrderStatus.Pending)]
    [InlineData(OrderStatus.Cancelled)]
    [InlineData(OrderStatus.Shipped)]
    public async Task ShipOrderWithWrongStatus(OrderStatus status)
    {
        var order = new Order { Id = Guid.NewGuid(), Status = status };
        _orders.Setup(x => x.GetByIdAsync(order.Id)).ReturnsAsync(order);

        // Проверяем запрет отгрузки
        var act = () => _service.ShipOrderAsync(order.Id);
        await act.Should().ThrowAsync<InvalidOperationException>();
    }

    // Отгружаемый заказ не найден
    [Fact]
    public async Task ShipOrderWithoutOrder()
    {
        var id = Guid.NewGuid();
        _orders.Setup(x => x.GetByIdAsync(id)).ReturnsAsync((Order?)null);

        // Проверяем исключение
        var act = () => _service.ShipOrderAsync(id);
        await act.Should().ThrowAsync<InvalidOperationException>();
    }
}
