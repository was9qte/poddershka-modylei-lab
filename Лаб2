using System;
class Program
{ static void Main()
{ 
Console.Write("Введите x: ");
    if (double.TryParse(Console.ReadLine(), out double x))
    {
        if (25 - x * x > 0)
        {
            double y = (x + 8) / Math.Sqrt(25 - x * x);

            Console.WriteLine($"f(x) = {y:F4}");
        }
        else
        {
            Console.WriteLine("Вычисление невозможно");
        }
    }
}
}
