using System;
class Program
{ static void Main()
{ 
Console.Write("Введите x: ");
    if (double.TryParse(Console.ReadLine(), out double x))
    {
        if (25 - x * x > 0)
        {
            double y = (x + 8) / Math.Sqrt(25 - x * x);

            Console.WriteLine($"f(x) = {y:F4}");
        }
        else
        {
            Console.WriteLine("Вычисление невозможно");
        }
    }
}
}







using System; using System.Text.RegularExpressions;
class Program { static void Main() { Console.Write("Введите номер автомобиля: "); string number = Console.ReadLine() ?? "";
    string pattern = @"^[АВЕКМНОРСТУХ]\d{3}[АВЕКМНОРСТУХ]{2} \d{2,3}$";

    if (Regex.IsMatch(number, pattern))
    {
        Console.WriteLine("Номер соответствует формату");
    }
    else
    {
        Console.WriteLine("Номер не соответствует формату");
    }
}
}
